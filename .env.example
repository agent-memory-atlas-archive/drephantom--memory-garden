# 私有 Vault 在仓库之外；公共演示模式强制仓库内合成库
MG_VAULT_PATH=D:/path/to/your/Obsidian Vault
MG_DATABASE_PATH=.local/memory_garden.db

# OpenAI 兼容 API。local = 确定性离线路径（零依赖、零密钥）；
# deepseek 等 = 模型自主选只读工具的多步循环。仅发送问题与工具筛出的少量片段。
MG_LLM_BASE_URL=https://api.deepseek.com
MG_LLM_API_KEY=
MG_LLM_API_KEY_FILE=
MG_LLM_CHAT_MODEL=deepseek-v4-flash
MG_LLM_REASONING_EFFORT=none
MG_LLM_TIMEOUT_SECONDS=60
MG_LLM_MAX_RETRIES=2
MG_ASSISTANT_BACKEND=local

# 她的名字与人格文件（soul.md 每条消息热加载，改完即生效）
MG_ASSISTANT_NAME=知微
MG_SOUL_PATH=
MG_PUBLIC_DEMO_MODE=false

# Agent 预算护栏
MG_AGENT_MAX_STEPS=10
MG_AGENT_MAX_TOOL_CALLS=16
MG_AGENT_TOOL_TIMEOUT_SECONDS=10
MG_AGENT_OVERALL_TIMEOUT_SECONDS=180
MG_AGENT_MAX_REPEAT_CALLS=2
MG_AGENT_NO_PROGRESS_STEPS=3
