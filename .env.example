# 私有 Vault 在仓库之外；公共演示模式强制仓库内合成库
MG_VAULT_PATH=
MG_DATABASE_PATH=.local/memory_garden.db
# 可选：指定笔记库选择的登记文件；留空则放在启动数据库旁，重启恢复上次选择。
MG_WORKSPACE_REGISTRY_PATH=

# OpenAI 兼容 API。local = 确定性离线路径（零依赖、零密钥）；
# deepseek 等 = 模型自主选只读工具的多步循环。问题、相关对话上下文与工具片段会发送到配置的服务。
MG_LLM_BASE_URL=https://api.deepseek.com
MG_LLM_API_KEY=
MG_LLM_API_KEY_FILE=
MG_LLM_CHAT_MODEL=deepseek-v4-flash
MG_LLM_EMBEDDING_MODEL=
# 0 表示接受 provider 实际返回维度；已知维度时可填写整数以做严格校验
MG_LLM_EMBEDDING_DIMENSION=0
MG_LLM_REASONING_EFFORT=none
MG_LLM_TIMEOUT_SECONDS=60
MG_LLM_MAX_RETRIES=2
MG_ASSISTANT_BACKEND=local

# 检索默认完全离线：BM25 + 字符 n-gram 哈希向量。
# embedding 模式只允许 mock/api；mock 仅用于测试，不代表真实模型效果。
MG_RETRIEVAL_MODE=hybrid
MG_EMBEDDING_BACKEND=local_hash
# Embedding 与生成模型可使用不同服务商；API Key 也可只通过仓库外文件注入。
MG_EMBEDDING_PROVIDER=openai_compatible
MG_EMBEDDING_BASE_URL=
MG_EMBEDDING_API_KEY=
MG_EMBEDDING_API_KEY_FILE=
MG_RERANKER_BACKEND=local_heuristic
MG_RERANKER_PROVIDER=openai_compatible
MG_RERANKER_BASE_URL=
MG_RERANKER_API_KEY=
MG_RERANKER_API_KEY_FILE=
MG_RERANKER_MODEL=
MG_RERANK_CANDIDATE_LIMIT=30
# rank_fusion 同时保留 RRF 与 cross-encoder 的排序证据；replace 仅作消融对照。
MG_RERANKER_FUSION=rank_fusion
MG_LOCAL_HASH_DIMENSION=512
MG_MOCK_EMBEDDING_DIMENSION=64
# 只有改为 true 才允许 api 后端发送查询文本及每条原子的标题、标题层级、标签、正文。
MG_ALLOW_CLOUD_EMBEDDING=false
# api reranker 会发送查询和 RRF 候选的标题、标题层级、标签、正文；默认禁止。
MG_ALLOW_CLOUD_RERANK=false

# 她的名字与人格文件（soul.md 每条消息热加载，改完即生效）
MG_ASSISTANT_NAME=知微
MG_SOUL_PATH=
MG_PUBLIC_DEMO_MODE=false
# 仅在 public demo 模式生效：true 使用生成模型 + 独立 agent-demo.db；false 是离线模板对照。
# Agent 演示发送新对话与选取的合成记录；不加载原来的私人 Vault/离线演示对话。
MG_DEMO_USE_MODEL=false

# Agent 预算护栏
MG_AGENT_MAX_STEPS=10
# 完整模型请求（含工具定义）的字符预算；超限时先压缩工具结果，真实 token 由 usage 记录。
MG_LLM_MAX_INPUT_CHARS=60000
MG_AGENT_MAX_TOOL_CALLS=16
MG_AGENT_TOOL_TIMEOUT_SECONDS=10
MG_AGENT_OVERALL_TIMEOUT_SECONDS=180
MG_AGENT_MAX_REPEAT_CALLS=2
MG_AGENT_NO_PROGRESS_STEPS=3
